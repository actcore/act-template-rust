[package]
# Unique per component: machines that share one cargo build-dir collide
# same-name crates on the fingerprint slot, and a suite can then run
# another component's test binary.
name = "e2e-{{ project_name }}"
version = "0.1.0"
edition = "2024"
publish = false

# Detach from any outer workspace this component may sit in.
[workspace]

[dev-dependencies]
rmcp = { version = "3.5", features = ["client", "transport-child-process"] }
tokio = { version = "1", features = ["macros", "rt-multi-thread", "process", "io-util", "sync", "time"] }
serde_json = "1"
